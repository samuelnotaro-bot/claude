# --- Piwik Pro API ---
# Base URL of your Piwik Pro organization, e.g. https://your-org.piwik.pro
PIWIK_BASE_URL=https://your-org.piwik.pro
# OAuth2 client credentials (create in Piwik Pro > Administration > Custom access clients)
# Required scope: "Read" access on Analytics + Apps management.
PIWIK_CLIENT_ID=
PIWIK_CLIENT_SECRET=

# "demo" runs entirely on generated mock data (no Piwik Pro calls) so you can try the app
# before wiring up real credentials. Switch to "live" once PIWIK_* vars above are set.
PIWIK_MODE=demo

# Per Piwik Pro's official API rate limits: GET (read) requests are 600/min,
# but non-GET requests -- including POST "even if they only retrieve data",
# which is how the Analytics Query API works -- are 60/min. Every metric this
# app fetches goes through that POST endpoint, so 60/min is the real ceiling
# for this app's traffic; only lower it if your specific contract grants less.
# Every Piwik Pro call this app makes is paced to stay under this ceiling.
PIWIK_MAX_REQUESTS_PER_MINUTE=60

# How many days back Piwik Pro actually keeps queryable data on your account/
# plan (26 months confirmed by the account owner -- check your own Piwik Pro
# contract, not discoverable via the API itself). Dates older than this will
# NEVER return data no matter how many times a gap-fill retries them: the app
# uses this to tell "will never be available" apart from "just not synced
# yet" in the UI, and to stop backfillGaps from wasting rate-limited API
# calls retrying dates it can never fill. Note this is Piwik Pro's own limit,
# not how far back BACKFILL_DAYS actually pulls on first run.
PIWIK_DATA_RETENTION_DAYS=791

# Optional: business choice (not a Piwik Pro limit) for how far back this app
# actually needs to sync/keep history -- e.g. "no need for 2024, 2025-01-01
# onward is enough". Every day further back than this costs real sync time
# against the rate limit for no analytical benefit. Combined with
# PIWIK_DATA_RETENTION_DAYS as whichever is the more RECENT (more
# restrictive) date -- setting this earlier than Piwik Pro's own retention
# has no effect (can't fetch data that doesn't exist there either way).
# Leave unset to sync all the way back to PIWIK_DATA_RETENTION_DAYS.
HISTORY_START_DATE=2025-01-01

# Optional: website id of a Piwik Pro Roll-Up Reporting property that
# aggregates every tracked site (Administration > Roll-Up Reporting in Piwik
# Pro, if available on your plan). When set, the 26-month/history sync
# queries this ONE property (with a website_name breakdown) instead of every
# site individually -- roughly (site count)x fewer Piwik Pro requests. Not
# auto-discoverable: a roll-up property doesn't appear in the normal site
# list API, only in Analytics Query results, so its id has to be copied from
# the Piwik Pro UI directly. Safe to leave unset: falls back to the proven
# per-site path automatically, and falls back live too if this ever fails.
PIWIK_ROLLUP_SITE_ID=

# --- Server ---
PORT=4000

# --- Base de données ---
# PostgreSQL (ex: Render PostgreSQL gratuit, ou une instance locale). Requis dans
# tous les modes, y compris "demo" -- sans base persistante, npm run seed:demo
# écrit dans une base qui doit exister au préalable (npm run build ne la crée pas,
# le serveur applique le schéma automatiquement au démarrage).
DATABASE_URL=postgres://user:password@localhost:5432/piwik_trends

# How far back to pull history on first run (used by `npm run backfill`)
BACKFILL_DAYS=90

# Cron expression for the daily metrics fetch (default: every day at 06:00)
FETCH_CRON=0 6 * * *
# Cron expression for the periodic synthesis (default: every Monday at 07:00 - weekly action plan)
SYNTHESIS_CRON=0 7 * * 1

# --- Accès au dashboard ---
# Protection type "htaccess" (HTTP Basic Auth) devant tout le dashboard + l'API.
# Obligatoire en PIWIK_MODE=live si le déploiement est accessible publiquement.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Web ---
# Uniquement pour le dev local (npm run dev:web sur son propre port). En production,
# le build web est servi par ce même serveur API (même origine) -- laisser vide.
VITE_API_BASE_URL=http://localhost:4000
